// Firebase Storage security rules for Maskani.
// This file is a copy for reference: rules only take effect after they are
// pasted into Firebase console -> Storage -> Rules and Published.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile photos: anyone signed in can view them, only the owner can upload (images under 5 MB)
    match /profile_photos/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
